# ============================================================================
# Output Files (Conditionally Ignored)
# ============================================================================
# Keep final reports, ignore drafts
06_outputs/reports/*_draft*.pdf
06_outputs/reports/*_v0*.pdf
06_outputs/reports/~$*.docx

# Keep publication charts, ignore work-in-progress
05_visualizations/publication_charts/*_wip.png
05_visualizations/publication_charts/*_draft.svg

# ============================================================================
# Logs and Temporary Files
# ============================================================================
*.log
*.tmp
*.bak
*.swp
*.swo
*~.nib
local.properties

# ============================================================================
# Archive / Old Structure (Post-Refactor)
# ============================================================================
# Keep archive directory but ignore its contents (reduce repo size)
archive/old_structure/*
!archive/old_structure/README.md
archive/deprecated_scripts/*
!archive/deprecated_scripts/README.md

# ============================================================================
# Validation & Review Files
# ============================================================================
# Keep validation scripts, ignore large log outputs
07_validation/validation_logs/*.json
!07_validation/validation_logs/.gitkeep

# Expert review responses (may contain private feedback)
07_validation/expert_review/review_responses/*.pdf
07_validation/expert_review/review_responses/*.docx
!07_validation/expert_review/review_responses/.gitkeep

# ============================================================================
# Supplementary Data (Large External Datasets)
# ============================================================================
# LinkedIn job data (scraped, regenerable)
08_supplementary_data/linkedin_job_analysis/*.csv
!08_supplementary_data/linkedin_job_analysis/job_title_taxonomy.json

# Conference data (manually curated, keep in git)
# (no ignore rules - keep all)

# Earnings call transcripts (large text files)
08_supplementary_data/company_financials/earnings_call_transcripts/*.txt
!08_supplementary_data/company_financials/earnings_call_transcripts/.gitkeep

# ============================================================================
# Keep These Files (Explicitly Track)
# ============================================================================
# Core documentation
!README.md
!CLAUDE.md
!STRATEGIC_ANALYSIS.md
!REPOSITORY_STRUCTURE.md
!METHODOLOGY.md
!CHANGELOG.md

# Configuration files
!requirements.txt
!requirements_dashboard.txt
!.gitignore

# Taxonomy definitions (critical for reproducibility)
!02_analysis/configs/*.json

# Master datasets (unless very large >50MB)
!03_processed_data/unified_ai_analysis.csv
!03_processed_data/big_firm_analysis.csv
!03_processed_data/company_profiles.csv
!03_processed_data/use_case_statistics.csv
!03_processed_data/data_dictionary.md

# Manual inputs (curated data, essential)
!01_data_collection/manual_inputs/*.csv
!01_data_collection/manual_inputs/*.xlsx
!01_data_collection/manual_inputs/README.md

# ============================================================================
# Git LFS (Large File Storage) - If Enabled
# ============================================================================
# Uncomment if using Git LFS for large files
# *.csv filter=lfs diff=lfs merge=lfs -text
# *.json filter=lfs diff=lfs merge=lfs -text
# *.xlsx filter=lfs diff=lfs merge=lfs -text

