# ============================================================================
# Project-Specific - Large Data Files
# ============================================================================
# Cache files (too large for git, but essential - keep locally)
02_analysis/caches/*.json
!02_analysis/caches/.gitkeep
!02_analysis/caches/cache_README.md

# Large raw scrape outputs (keep only latest in git)
01_data_collection/raw_outputs/*.csv
!01_data_collection/raw_outputs/.gitkeep
01_data_collection/raw_outputs/scraping_logs/*.log

# Processed data backups (keep master files only)
03_processed_data/*_backup_*.csv
03_processed_data/*_YYYYMMDD.csv

# Temporary analysis outputs
04_advanced_analysis/temp/
04_advanced_analysis/*.tmp

# Dashboard cache
05_visualizations/.streamlit/cache/

# ============================================================================
# Sensitive Data
# ============================================================================
# API keys and credentials
**/secrets.json
**/credentials.json
**/.env.local
**/.env.*.local

# Personal notes (may contain unpublished research)
**/PERSONAL_NOTES.md
**/TODO_PRIVATE.md

