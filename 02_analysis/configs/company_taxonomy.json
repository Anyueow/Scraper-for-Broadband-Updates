  "company_pairing_rules": {
    "_comment": "Define which companies should be merged/combined in analysis",
    "pairs": [
      {
        "primary": "BT",
        "merge_with": ["Openreach"],
        "reason": "Wholly owned subsidiary, network operations closely tied",
        "separate_when": "Analyzing regulatory separation or wholesale vs retail"
      },
      {
        "primary": "Virgin Media O2",
        "merge_with": ["nexfibre"],
        "reason": "Joint venture majority owned by VMO2",
        "separate_when": "Analyzing infrastructure investment separately"
      },
      {
        "primary": "Netomnia",
        "merge_with": ["Brsk", "YouFibre"],
        "reason": "Common ownership and shared infrastructure",
        "separate_when": "Analyzing retail vs wholesale separately"
      }
    ]
  },

  "extraction_hints": {
    "_comment": "Patterns to help LLM identify companies in text",
    "common_patterns": [
      "Company Name + ('s|is|has|will|announced|deployed|launched)",
      "At Company Name,",
      "Company Name CTO|CEO|executive",
      "according to Company Name",
      "Company Name and Partner announced"
    ],
    "exclusion_patterns": [
      "UK Government",
      "Ofcom",
      "Parliament",
      "Department for",
      "OpenAI",
      "Anthropic",
      "Google (when referring to AI models, not Google Cloud)"
    ]
  }
